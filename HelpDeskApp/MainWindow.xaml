<Window
        x:Class="HelpDeskApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:HelpDeskApp.Helpers"
        mc:Ignorable="d"
        Title="HelpDesk Dashboard" Height="800" Width="1000"
        >
    <Window.Resources>
        <helpers:HasAttachmentsConverter x:Key="HasAttachmentsConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        <!-- Zeile 0: header + Expander + Buttons + Einstellungen -->
        <ScrollViewer Grid.Row="0" 
                      VerticalScrollBarVisibility="Auto" 
                      MaxHeight="500">
            <StackPanel Margin="10">
                <Expander Header="▶ Neues Ticket erstellen" 
                          IsExpanded="{Binding IsExpanderOpen}" 
                          Foreground="DarkBlue" 
                          FontSize="16" 
                          FontWeight="Bold" 
                          Margin="20, 5, 20, 5">
                    <StackPanel>
                        <!-- Titel -->
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0,5,0,5">
                            <Label Content="Titel:" 
                                   Width="120" 
                                   FontSize="14" 
                                   Foreground="DarkBlue"/>
                            <TextBox Text="{Binding NewTicketTitle, 
                                    UpdateSourceTrigger=PropertyChanged}" 
                                    Width="400" 
                                    Height="30" 
                                    Background="AliceBlue"/>
                        </StackPanel>
                        <!-- Beschreibung -->
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0,5,0,5">
                            <Label Content="Beschreibung:" 
                                   Width="120" 
                                   FontSize="14" 
                                   Foreground="DarkBlue"/>
                            <TextBox Text="{Binding NewTicketDescription, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="400" 
                                     Height="30" 
                                     Background="AliceBlue"/>
                        </StackPanel>
                        <!-- Ort -->
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0,5,0,5">
                            <Label Content="Ort:" 
                                   Width="120" 
                                   FontSize="14" 
                                   Foreground="DarkBlue"/>
                            <TextBox Text="{Binding NewTicketLocation, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="400" 
                                     Height="30" 
                                     Background="AliceBlue"/>
                        </StackPanel>
                        <!-- Attachments hinzufügen -->
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0,5,0,5">
                            <Label Content="Anlage(n):" 
                                   Width="120" 
                                   FontSize="14" 
                                   Foreground="DarkBlue"/>

                            <Button Content="+ Anhang hinzufügen" 
                                    Command="{Binding AttachmentHinzufuegenCommand}" 
                                    Padding="5" 
                                    Background="DarkBlue" 
                                    Foreground="AliceBlue"/>
                        </StackPanel>
                        <!-- Attachment Liste -->
                        <ItemsControl ItemsSource="{Binding NewTicketAttachments}" 
                                      Margin="120,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                Margin="0,2,0,2">
                                        <TextBlock Text="{Binding}" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="DarkBlue" 
                                                   Width="300"/>
                                        <Button Content=" X entfernen" 
                                                Command="{Binding DataContext.AttachmentEntfernenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                CommandParameter="{Binding}" 
                                                Foreground="Red" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                FontSize="16"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <!-- Buttons-->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left" 
                            Margin="20, 5, 20, 5">
                    <Button x:Name="KritischesTicketButton" 
                            Content="Kritisches Ticket" 
                            Command="{Binding KritischesTicketCommand}" 
                            Margin="10" 
                            Padding="10 " 
                            Background="DarkBlue" 
                            Foreground="White" 
                            FontSize="16" 
                            FontWeight="Bold">
                        <Button.ToolTip>
                            <ToolTip>
                                <TextBlock>
                            <Bold>Kritisches Ticket</Bold>
                            <LineBreak/>
                            Systemausfall, Datenverlust oder kompletter Arbeitsstillstand
                                </TextBlock>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="NormalesTicketButton" 
                            Content="Normales Ticket" 
                            Command="{Binding NormalesTicketCommand}" 
                            Margin="10" 
                            Padding="10" 
                            Background="DarkBlue" 
                            Foreground="White" 
                            FontSize="16" 
                            FontWeight="Bold"/>
                    <!-- Header mit User-Info und Logout -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Left"
                                Margin="320,5,20,5">
                        <Label Foreground="DarkBlue"
                                FontSize="14"
                                FontWeight="Bold"
                                VerticalAlignment="Center"
                                Margin="10,0,10,0">
                                Angemeldet als:
                        </Label>
                        <TextBlock Text="{Binding CurrentUser}" 
                                Foreground="DarkBlue"
                                FontSize="14"
                                FontWeight="Bold"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>
                            <Button Content="Abmelden"
                                Command="{Binding LogoutCommand}"
                                Padding="8"
                                Background="DarkRed"
                                Foreground="White"
                                FontSize="12"
                                FontWeight="Bold"/>
                        </StackPanel>
                </StackPanel>
                
                <!-- aktull nicht benötigt, daher ausgeblendet... Anfang-->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left" 
                            Margin="20, 5, 20, 5"
                            Visibility="Collapsed">
                    <Label Content="Benachrichtigung:" 
                           VerticalAlignment="Top" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="DarkBlue"/>
                    <StackPanel Orientation="Vertical">
                        <RadioButton x:Name="RadioButtonEmail" 
                                     Content="Email" 
                                     IsChecked="{Binding NotifyByEmail}" 
                                     FontSize="16" VerticalAlignment="Top" 
                                     Margin="5,10,5,0" Foreground="DarkBlue"/>
                        <RadioButton x:Name="RadioButtonConsole" 
                                     Content="Console" 
                                     IsChecked="{Binding NotifyByConsole}"
                                     FontSize="16" 
                                     VerticalAlignment="Top" 
                                     Margin="5,10,5,0"
                                     Foreground="DarkBlue"/>
                    </StackPanel>
                </StackPanel>
                <!-- aktull nicht benötigt, daher ausgeblendet... Ende-->
                
                <StackPanel Margin="20,0,20,0">
                        <StackPanel Orientation="Horizontal" >
                            <Label  Content="Vorlagen:" 
                                    FontSize="16" 
                                    FontWeight="Bold"
                                    Margin="5"
                                    Foreground="DarkBlue"/>
                            <Button Content="👥 Benutzerverwaltung"
                                    Command="{Binding BenutzerverwaltungCommand}"
                                    Margin="580,5,10,0"
                                    Width="200"
                                    Padding="10"
                                    Background="DarkBlue"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Left" 
                                Margin="10">
                    
                    <ComboBox   x:Name="VorlageAuswahlDropdwn" 
                                    ItemsSource="{Binding Templates}"
                                    SelectedItem="{Binding SelectedTemplate}"
                                    DisplayMemberPath="Title"
                                    Margin="0,5,10,0"
                                    Width="145"
                                    Background="AliceBlue"/>
                    <Button Content="Vorlage klonen"
                                Command="{Binding VorlageKlonenCommand}"
                                Margin="10,5,10,0"
                                Width="145" 
                            Padding="10"
                                Background="DarkBlue"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="Bold"/>

                    <!-- NUR für Admin sichtbar: -->
                    <Button Content="+ Vorlage anlegen"
                                Command="{Binding VorlageAnlegenCommand}"
                                Margin="10,7,10,0"
                                Width="145"
                                Padding="10"
                                Background="DarkGreen"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="Bold"
                                Visibility="{Binding IsAdmin, 
                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Left" 
                            Margin="20, 5, 20, 5">
                    <Button x:Name="TagesberichtErstellenButton" 
                            Content="📄 Tagesbericht erstellen" 
                            Command="{Binding TagesberichtCommand}" 
                            HorizontalAlignment="Left" 
                            Margin="10" 
                            Width="300" 
                            Padding="10" 
                            Background="DarkBlue" 
                            Foreground="White" 
                            FontSize="16" 
                            FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- Zeile 1: Ticket-Liste-->
        <DockPanel Grid.Row="1"
                   Margin="20, 5, 20, 5"  
                   ScrollViewer.VerticalScrollBarVisibility="Auto" 
                   HorizontalAlignment="Left">
            <Label DockPanel.Dock ="Top" 
                   Content="Ticket-Liste:" 
                   Foreground="DarkBlue" 
                   Margin="15, 0, 15, 0" 
                   FontSize="16" 
                   FontWeight="Bold" />
            <!-- Admin Buttons unter ListView: -->
            <StackPanel DockPanel.Dock="Bottom" 
                        Orientation="Horizontal"
                        Margin="20,5,20,5"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="✏️ Bearbeiten"
                        Command="{Binding TicketBearbeitenCommand}"
                        Margin="5" Padding="8"
                        Background="DarkBlue"
                        Foreground="White"
                        FontWeight="Bold"/>
                <Button Content="🗑️ Löschen"
                        Command="{Binding TicketLoeschenCommand}"
                        Margin="5" Padding="8"
                        Background="DarkRed"
                        Foreground="White"
                        FontWeight="Bold"/>
                <Button Content="📋 Als Vorlage"
                        Command="{Binding AlsVorlageCommand}"
                        Margin="5" Padding="8"
                        Background="DarkGreen"
                        Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
            <ListView x:Name="TicketListe" ItemsSource="{Binding Tickets}" 
                      SelectedItem="{Binding SelectedTicket}" 
                      Margin="20" Foreground="DarkBlue" 
                      Background="AliceBlue">
                <ListView.View>
                    <GridView>
                        <!-- Spalte 0: Priorität -->
                        <GridViewColumn Header="Datum/Zeit" 
                                        DisplayMemberBinding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" 
                                        Width="110"/>
                        <!-- Spalte 1: Priorität -->
                        <GridViewColumn Header="Priorität" 
                                        DisplayMemberBinding="{Binding Priority}" 
                                        Width="70"/>
                        <!-- Spalte 2: Titel -->
                        <GridViewColumn Header="Titel"
                                        DisplayMemberBinding="{Binding Title}"
                                        Width="150"/>
                        <!-- Spalte 3: Status -->
                        <GridViewColumn Header="Status"
                                        DisplayMemberBinding="{Binding Status}"
                                        Width="100"/>
                        <!-- Spalte 4: Beschreibung -->
                        <GridViewColumn Header="Beschreibung"
                                        DisplayMemberBinding="{Binding Description}"
                                        Width="260"/>
                        <!-- Spalte 5: Beschreibung -->
                        <GridViewColumn Header="Ort"
                                        DisplayMemberBinding="{Binding Location}"
                                        Width="127"/>
                        <!-- Spalte 6: Anhang -->
                        <GridViewColumn Header="Anlage(n)" 
                                        DisplayMemberBinding="{Binding Attachments, 
                                        Converter={StaticResource HasAttachmentsConverter}}" 
                                        Width="60"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
        <!-- Zeile 2: Log - nur für Admins -->
        <StackPanel Grid.Row="2" 
                    Margin="20,0,20,0"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <Label  Content="Log:" 
                        Foreground="DarkBlue" 
                        Margin="15,0,15,10" 
                        FontSize="16" 
                        FontWeight="Bold"/>

                <!-- NUR für Admin: -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,10,0,10">
                    <Button Content="📄 Log Exportieren" 
                            Command="{Binding LogExportierenCommand}"
                            Margin="5,0,5,0"
                            Padding="5"
                            Background="DarkBlue"
                            Foreground="White"
                            FontWeight="Bold"/>
                    <Button Content="🗑️ Log Leeren"
                            Command="{Binding LogLeerenCommand}"
                            Margin="5,0,5,0"
                            Padding="5"
                            Background="DarkRed"
                            Foreground="White"
                            FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <TextBox x:Name="LogTextBox" 
                    Text="{Binding LogText, Mode=OneWay}" 
                    Margin="20,0,20,0" 
                    Height="70" 
                    IsReadOnly="True" 
                    VerticalScrollBarVisibility="Auto" 
                    Background="AliceBlue"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>


<!--
Merken:
    
Immer wenn du den Namen einer Property, 
Variable oder Methode als String brauchst
→ nameof() benutzen!

Ausnahme: Feste Texte die nie einen Code-Bezug haben
→ "Hallo Welt", "Tagesbericht exportiert" usw.
→ da ist ein normaler String ok!
-->