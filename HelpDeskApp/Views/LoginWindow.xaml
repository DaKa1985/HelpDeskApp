<Window x:Class="HelpDeskApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk Login" 
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0" 
                   Text="HelpDesk Login"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Username -->
        <StackPanel Grid.Row="1" Margin="0,5,0,5">
            <Label Content="Benutzername:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"/>
            <TextBox x:Name="UsernameInput"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Background="AliceBlue"/>
        </StackPanel>

        <!-- Passwort -->
        <StackPanel Grid.Row="2" Margin="0,5,0,15">
            <Label Content="Passwort:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"/>
            <PasswordBox x:Name="PasswordInput"
                         Height="30"
                         Background="AliceBlue"/>
        </StackPanel>

        <!-- Fehlermeldung -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" 
            Orientation="Horizontal"
            HorizontalAlignment="Center">
            <Button Content="Anmelden"
            Click="LoginButton_Click"
            Width="120"
            Height="35"
            Margin="5"
            Background="DarkBlue"
            Foreground="White"
            FontWeight="Bold"/>
            <Button Content="Registrieren"
            Click="RegisterButton_Click"
            Width="120"
            Height="35"
            Margin="5"
            Background="DarkGreen"
            Foreground="White"
            FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>