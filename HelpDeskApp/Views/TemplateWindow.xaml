<Window x:Class="HelpDeskApp.Views.TemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vorlage anlegen" 
        Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Neue Vorlage anlegen"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Titel Eingabe -->
        <StackPanel Grid.Row="1" Margin="0,5,0,5">
            <Label Content="Titel:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Background="AliceBlue"/>
        </StackPanel>

        <!-- Beschreibung -->
        <StackPanel Grid.Row="2" Margin="0,5,0,5">
            <Label Content="Beschreibung:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"/>
            <TextBox Text="{Binding DefaultDescription, UpdateSourceTrigger=PropertyChanged}"
                     Height="60"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Background="AliceBlue"/>
        </StackPanel>

        <!-- Priorität -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    Margin="0,10,0,10">
            <Label Content="Priorität:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>
            <RadioButton Content="Kritisch"
                         IsChecked="{Binding IsKritisch}"
                         Margin="10,0,0,0"
                         Foreground="DarkBlue"
                         VerticalAlignment="Center"/>
            <RadioButton Content="Normal"
                         IsChecked="{Binding IsNormal}"
                         Margin="10,0,0,0"
                         Foreground="DarkBlue"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button Content="💾 Speichern"
                    Command="{Binding SaveCommand}"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Background="DarkGreen"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="✖ Abbrechen"
                    Click="AbbrechenButton_Click"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Background="DarkRed"
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>