<Window x:Class="HelpDeskApp.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benutzerverwaltung" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Benutzerverwaltung"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Benutzerliste -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Benutzer}"
                  SelectedItem="{Binding SelectedBenutzer}"
                  Margin="0,0,0,10"
                  Background="AliceBlue">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Benutzername"
                                    DisplayMemberBinding="{Binding UserName}"
                                    Width="150"/>
                    <GridViewColumn Header="Admin"
                                    DisplayMemberBinding="{Binding IsAdmin}"
                                    Width="80"/>
                    <GridViewColumn Header="Aktiv"
                                    DisplayMemberBinding="{Binding IsActive}"
                                    Width="80"/>
                    <GridViewColumn Header="Erstellt am"
                                    DisplayMemberBinding="{Binding CreatedAt, 
                                    StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="130"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="👑 Admin machen"
                    Command="{Binding AdminMachenCommand}"
                    Margin="5" Padding="8"
                    Background="DarkBlue"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="👤 Admin entfernen"
                    Command="{Binding AdminEntfernenCommand}"
                    Margin="5" Padding="8"
                    Background="DarkOrange"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="✅ Aktivieren"
                    Command="{Binding AktivierenCommand}"
                    Margin="5" Padding="8"
                    Background="DarkGreen"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="🚫 Deaktivieren"
                    Command="{Binding DeaktivierenCommand}"
                    Margin="5" Padding="8"
                    Background="DarkRed"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="✖ Schließen"
                    Click="SchliessenButton_Click"
                    Margin="5" Padding="8"
                    Background="Gray"
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>