<Window x:Class="HelpDeskApp.Views.TicketDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket bearbeiten" 
        Height="650" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Ticket bearbeiten"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Ticket Info (readonly) -->
        <StackPanel Grid.Row="1" Margin="0,5,0,5">
            <Label Content="Titel:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"/>
            <TextBox Text="{Binding TicketTitle, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="LightGray"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5,0,5">
            <Label Content="Beschreibung:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"/>
            <TextBox Text="{Binding TicketDescription, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="LightGray"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,5,0,5">
            <Label Content="Ort:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"/>
            <TextBox Text="{Binding TicketLocation, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="LightGray"
                     Height="30"/>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal"
                    Margin="0,10,0,5">
            <Label Content="Status:" 
                   Foreground="DarkBlue"
                   FontWeight="Bold"
                   Width="120"
                   VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding StatusOptionen}"
                      SelectedItem="{Binding SelectedStatus}"
                      Width="200"
                      Height="30"
                      Background="AliceBlue"/>
        </StackPanel>

        <!-- Zugewiesen an -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Margin="0,5,0,5">
            <Label Content="Zugewiesen an:"
                   Foreground="DarkBlue"
                   FontWeight="Bold"
                   Width="120"
                   VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Benutzer}"
                      SelectedItem="{Binding SelectedBenutzer}"
                      DisplayMemberPath="UserName"
                      Width="200"
                      Height="30"
                      Background="AliceBlue"/>
        </StackPanel>

        <!-- Interne Notizen (readonly – Verlauf): -->
        <StackPanel Grid.Row="6" Margin="0,5,0,5">
            <Label Content="Notiz-Verlauf:" 
           Foreground="DarkBlue"
           FontWeight="Bold"/>
            <TextBox Text="{Binding InternalNote, Mode=OneWay}"
             Height="80"
             IsReadOnly="True"
             TextWrapping="Wrap"
             Background="LightGray"
             VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Neue Notiz eingeben: -->
        <StackPanel Grid.Row="7" Margin="0,5,0,5">
            <Label Content="Neue Notiz:" 
           Foreground="DarkBlue"
           FontWeight="Bold"/>
            <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
             Height="50"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             Background="AliceBlue"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button Content="💾 Speichern"
                    Command="{Binding SaveCommand}"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Background="DarkGreen"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="✖ Schließen"
                    Click="SchliessenButton_Click"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Background="DarkRed"
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>